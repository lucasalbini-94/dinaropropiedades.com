<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.master.cs" Inherits="Ventanas.Admin" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dinaro Propiedades | Administración</title>
    <link href="/Images/ImgApp/favicon.ico" rel="icon" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        .margin-top {
            margin-top: 56px;
        }
    </style>
    <link href="css/styles.css" rel="stylesheet" />
    <%--Bootstrap--%>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossorigin="anonymous">
    <%--Font Awesome--%>
    <script src="https://kit.fontawesome.com/44819e608f.js" crossorigin="anonymous"></script>
    <script src="js/scripts.js"></script>
</head>
<body class="bg-secondary-subtle">
    <nav class="sb-topnav navbar navbar-expand navbar-dark bg-dark">
        <!-- Navbar Brand-->
        <a class="navbar-brand ps-3" href="index.html">Dinaro Propiedades</a>
        <!-- Sidebar Toggle-->
        <button class="btn btn-link btn-sm order-1 order-lg-0 me-4 me-lg-0" id="sidebarToggle" href="#!"><i class="fas fa-bars"></i></button>
    </nav>
    <div id="layoutSidenav">
        <div id="layoutSidenav_nav">
            <nav class="sb-sidenav accordion sb-sidenav-dark" id="sidenavAccordion">
                <div class="sb-sidenav-menu">
                    <div class="nav">
                        <div class="sb-sidenav-menu-heading">Panel</div>
                        <a class="nav-link" href="DefaultAdmin.aspx">
                            <div class="sb-nav-link-icon"><i class="fa-solid fa-house-circle-check"></i></div>
                            Propiedades
                        </a>
                        <a class="nav-link" href="PropiedadAdmin.aspx">
                            <div class="sb-nav-link-icon"><i class="fa-solid fa-plus"></i></div>
                            Nueva propiedad
                        </a>
                        <div class="sb-sidenav-menu-heading">Mantenimiento</div>
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapseLayouts" aria-expanded="false" aria-controls="collapseLayouts">
                            <div class="sb-nav-link-icon"><i class="fa-solid fa-location-dot"></i></div>
                            Ubicaciónes
                                <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapseLayouts" aria-labelledby="headingOne" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" href="Desplegables.aspx?campo=Dpto">Departamentos</a>
                                <a class="nav-link" href="Desplegables.aspx?campo=Loc">Localidades</a>
                                <a class="nav-link" href="Desplegables.aspx?campo=Pue">Barrios</a>
                            </nav>
                        </div>
                        <a class="nav-link collapsed" href="#" data-bs-toggle="collapse" data-bs-target="#collapsePages" aria-expanded="false" aria-controls="collapsePages">
                            <div class="sb-nav-link-icon"><i class="fas fa-book-open"></i></div>
                            Propiedades y contratos
                                <div class="sb-sidenav-collapse-arrow"><i class="fas fa-angle-down"></i></div>
                        </a>
                        <div class="collapse" id="collapsePages" aria-labelledby="headingOne" data-bs-parent="#sidenavAccordion">
                            <nav class="sb-sidenav-menu-nested nav">
                                <a class="nav-link" href="Desplegables.aspx?campo=TP">Tipos de propiedad</a>
                                <a class="nav-link" href="Desplegables.aspx?campo=TC">Tipos de contrato</a>
                            </nav>
                        </div>
                        <div class="sb-sidenav-menu-heading">Herramientas</div>
                        <a class="nav-link" href="QR.aspx">
                            <div class="sb-nav-link-icon"><i class="fa-solid fa-qrcode"></i></div>
                            Generador de QR
                        </a>
                        <a class="nav-link" target="_blank" href="Default.aspx">
                            <div class="sb-nav-link-icon"><i class="fas fa-eye"></i></div>
                            Vista de usuario
                        </a>
                    </div>
                </div>
            </nav>
        </div>
        <div id="layoutSidenav_content">
            <main>
                <div class="container-fluid px-4">
                    <form id="form1" runat="server">
                        <div>
                            <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
                            </asp:ContentPlaceHolder>
                        </div>
                    </form>
                </div>
            </main>
            <footer class="py-4 bg-light mt-auto">
                <div class="container-fluid px-4">
                    <div class="d-flex align-items-center justify-content-between small">
                        <div class="text-muted">Copyright &copy; Dinaro Propiedades 2024</div>
                    </div>
                </div>
            </footer>
        </div>
    </div>
    <%--Bootstrap--%>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js" integrity="sha384-YvpcrYf0tY3lHB60NNkmXc5s9fDVZLESaAA55NDzOxhy9GkcIdslK1eN7N6jIeHz" crossorigin="anonymous"></script>
</body>
</html>
