<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="User.Master.cs" Inherits="Ventanas.Master" %>

<!DOCTYPE html>

<html lang="es">

<head runat="server">
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Dinaro Propiedades</title>
    <link href="/Images/ImgApp/logo.png" rel="icon" />
    <link href="/css/styles.css" rel="stylesheet" />
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    
    <%--Font Awesome--%>
    <script src="https://kit.fontawesome.com/44819e608f.js" crossorigin="anonymous"></script>
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar">
        <%--Logo--%>
        <a href="#"><img class="logo-img" src="/Images/ImgApp/logo.png" alt="Logo de la empresa" /></a>

        <%--Botón hamburguesa para dispositivos móviles--%>
        <div class="hamburguesa" id="hamburguesa">
            <span class="bar"></span>
            <span class="bar"></span>
            <span class="bar"></span>
        </div>

        <%--Menú de navegación--%>
        <ul class="nav-list" id="nav-list">
            <li><a class="nav-item" href="#">Inicio</a></li>
            <li><a class="nav-item" href="#">Viviendas</a></li>
            <li><a class="nav-item" href="#">Lotes</a></li>
            <li><a class="nav-item" href="#">Sobre nosotros</a></li>
            <li><a class="nav-item" href="#">Nuestras construcciónes</a></li>
            <li><a class="nav-item" href="#">FAQ</a></li>
            <li><a class="btn-login" href="#">Iniciar sesión</a></li>
        </ul>
    </nav>
    <%--Contenedor--%>
    <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
    </asp:ContentPlaceHolder>
    <!-- Footer -->
    <footer class="main-footer">
        <div class="footer-container">
            <div class="footer-col branding">
                <img src="/Images/ImgApp/colegiodecorredores.jpg" alt="Colegio de Corredores" class="img-colegio">
                <h3>Elio Ezequiel Dinaro</h3>
                <p>Corredor Inmobiliario y Martillero Público</p>
                <p>Mat. Prof. N° 2070</p>
            </div>
            <div class="footer-col">
                <h4>Menú</h4>
                <ul>
                    <li><a href="#">Inicio</a></li>
                    <li><a href="#">Terrenos</a></li>
                    <li><a href="#">Propiedades</a></li>
                    <li><a href="#">Sobre nosotros</a></li>
                    <li><a href="#">Nuestras construcciones</a></li>
                    <li><a href="#">FAQ</a></li>
                </ul>
            </div>
            <div class="footer-col">
                <h4>Contacto</h4>
                <ul class="social-links">
                    <li><a href="#"><i class="fab fa-whatsapp"></i> WhatsApp</a></li>
                    <li><a href="#"><i class="fab fa-instagram"></i> Instagram</a></li>
                    <li><a href="#"><i class="fab fa-facebook-f"></i> Facebook</a></li>
                    <li><a href="#"><i class="fab fa-youtube"></i> Youtube</a></li>
                    <li><a href="#"><i class="fas fa-envelope"></i> Email</a></li>
                </ul>
            </div>
        </div>
        <div class="footer-bottom">
            <p>&copy; <%: DateTime.Now.Year %> Dinaro Propiedades. Todos los derechos reservados.</p>
            <p class="dev-credit">Desarrollado por <a href="#" target="_blank" class="linkedin-link"><i class="fab fa-linkedin"></i> Lucas ALbini</a></p>
        </div>
    </footer>
    <script src='<%= ResolveUrl("~/js/scripts.js") %>'></script>
</body>
</html>
